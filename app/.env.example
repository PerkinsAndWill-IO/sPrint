# Public URL, used for OG Image when running nuxt generate
NUXT_PUBLIC_SITE_URL=

# Autodesk Platform Services app (3-legged OAuth)
APS_CLIENT_ID=
APS_CLIENT_SECRET=
APS_REDIRECT_URI=http://localhost:3000/api/auth/aps/callback

# PostHog (logs, errors, product analytics). Leave unset locally: everything
# then goes to the console only. The project key is public (write-only) and is
# used by both the browser and the server.
# Read at build time:
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Or override at runtime without a rebuild:
# NUXT_PUBLIC_POSTHOG_KEY=
# NUXT_PUBLIC_POSTHOG_HOST=
